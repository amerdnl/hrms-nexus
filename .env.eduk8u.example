# Settings for the EDUK8U Group review environment.
#
#   cp .env.eduk8u.example .env.eduk8u
#
# Then fill in the two required values below. Copy it to .env.eduk8u and nothing
# else: .env.eduk8u is ignored by Git and must never be committed.
#
# These are separate from .env on purpose. The review environment has its own
# database, its own container and its own secrets, so nothing shared with the
# Meridian presentation environment can be changed by editing this file.

# The Postgres password for the review environment's own database container.
# Anything long and random; it is never typed by a person.
POSTGRES_PASSWORD=change-me

# Used to sign sign-in tokens. Generate a fresh one, for example:
#   openssl rand -base64 48
# Do not reuse the presentation environment's secret.
JWT_SECRET=replace-with-a-long-random-secret

# How long a sign-in lasts.
JWT_EXPIRES_IN=8h

# The reviewer's administrator account. The .invalid suffix is reserved by
# RFC 2606 and can never be a real mailbox, which is what you want until you
# decide to give the account a real address.
EDUK8U_ADMIN_EMAIL=hr.review@eduk8u.invalid

# Optional. Leave it commented out and the bootstrap generates a password and
# prints it once, into the container log, where you can read it with:
#   docker compose -f docker-compose.eduk8u.yml logs eduk8u-setup
# Either way the account must choose a new password at first sign-in, so the
# value here stops working as soon as anyone uses it.
# EDUK8U_ADMIN_PASSWORD=
