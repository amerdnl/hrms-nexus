{
  "name": "backend",
  "version": "1.0.0",
  "description": "HR Nexus backend API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm run build:api",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate:status": "tsx src/database/migrate.ts status",
    "migrate:apply": "tsx src/database/migrate.ts apply",
    "db:schema": "tsx src/database/applySchema.ts",
    "db:migrate": "tsx src/database/migrate.ts apply",
    "db:bootstrap:eduk8u": "tsx src/database/bootstrapEduk8u.ts",
    "build:api": "esbuild src/app.ts --bundle --platform=node --target=node22 --format=cjs --outfile=../api/index.js --external:pg-native --external:pg-cloudflare --banner:js=\"/* GENERATED FILE - do not edit. Rebuild with: npm --prefix backend run build:api */\nconst __vcImportMetaUrl = require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=__vcImportMetaUrl --footer:js=\"module.exports = module.exports.default || module.exports;\""
  },
  "keywords": [],
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "esbuild": "^0.28.1",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.8",
    "typescript": "~6.0.2"
  }
}
