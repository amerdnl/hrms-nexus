node_modules/
**/node_modules/

.env
*.env
# Per-environment files such as .env.eduk8u hold real secrets and end in the
# environment's name, not in ".env", so the two patterns above never caught them.
.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

dist/
**/dist/

*.log
npm-debug.log*

.vscode/
.DS_Store
Thumbs.db

coverage/

# Local database recovery artifacts must never be committed.
.local-backups/

backend/uploads/profile-images/*
!backend/uploads/profile-images/.gitkeep

# Local tooling state: git worktrees and editor scratch, never part of a build.
.kilo/

# api/index.js is a generated esbuild bundle but IS committed on purpose: it is
# the deployed serverless function, and committing it keeps the host from having
# to resolve, install or choose a module format for the API at all. Rebuild with
# `npm --prefix backend run build:api` whenever backend/src changes.
